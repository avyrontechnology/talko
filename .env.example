CONSOLE_GRPC_HOST="your-example-grpc.company.ai"
CONSOLE_GRPC_PORT=12345
# GRPC_CERT_PATH = ""
# GRPC_KEY_PATH = ""
# GRPC_CA_CERT_PATH = ""

STORAGE_SERVICE_PROVIDER=DIGITAL_OCEAN
DO_ENDPOINT_URL=https://example-space.region.digitaloceanspaces.com
DO_SPACE_NAME=example-space-name
DO_SECRET_ACCESS_KEY=mock-secret-access-key
DO_ACCESS_KEY_ID=mock-access-key-id

# Cloudinary file storage (STORAGE_SERVICE_PROVIDER=CLOUDINARY)
CLOUDINARY_CLOUD_NAME=example-cloud
CLOUDINARY_API_KEY=example-key
CLOUDINARY_API_SECRET=example-secret
CLOUDINARY_FOLDER=talko
ENV=int
SERVICE_NAME=template-service
LOGGING_CONFIG_PATH=src/config/log.py

# voiceai trunk (Talko relays Tata media to voiceai instead of makun-ai
# when a call carries context_data.voiceai_agent_id). Empty = feature off.
# VOICEAI_API_BASE_URL=https://voiceai.example.com
# VOICEAI_WS_BASE_URL=wss://voiceai.example.com
# VOICEAI_API_KEY=<voiceai Bearer API key with calls:write scope>
# VOICEAI_INBOUND_AGENT_MAP={"918045678901": "agent_abc123"}

POSTGRES_DB=example_db
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CACHE_PROTOCOL=rediss
CACHE_USERNAME=default
CACHE_PASSWORD=your_redis_password
CACHE_HOST=your_redis_host
CACHE_PORT=12345
CACHE_DB=1
